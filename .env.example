# miku-agent configuration. Copy to .env and fill in.
# Everything here has a default except the API key.

# --- Provider ---------------------------------------------------------------
# Which registered provider descriptor to use. Only "greennode" exists today;
# adding another means adding a descriptor in miku/runtime/providers.py, not
# editing any call site.
MIKU_PROVIDER=greennode

# GreenNode: an OpenAI-compatible endpoint. The key is the only required value.
GREENNODE_API_KEY=
GREENNODE_BASE_URL=https://maas-llm-aiplatform-hcm.api.vngcloud.vn/v1

# --- Model roles ------------------------------------------------------------
# Optional overrides. Blank means "use the descriptor default for that role".
# Roles: main (the agent), fast (cheap work), judge (evals), select (the fan-out's
# pick), embed (later). judge and select are separate on purpose -- see below.
# GreenNode's catalog, as of the design spike:
#   google/gemma-4-31b-it   qwen/qwen3-5-27b   openai/gpt-4o-mini
#   baai/bge-m3             gemini/gemini-embedding-001
# MIKU_MODEL_MAIN=
# MIKU_MODEL_FAST=
# MIKU_MODEL_EMBED=
#
# `judge` defaults to the same model as `main`, which is unusual and measured:
# the previously distinct judge answered "fail" to every case involving a date,
# correct or not. Point this at another model to compare judges without editing
# the descriptor -- that is how the two were compared in the first place.
# MIKU_MODEL_JUDGE=
#
# `select` is what the fan-out uses to pick among candidate slots. It was the
# same role as `judge` until remapping the judge moved that production choice as
# a side effect. Grading evals and choosing a slot for a real person are
# different jobs, so they get different knobs.
# MIKU_MODEL_SELECT=

# --- Loop -------------------------------------------------------------------
# Hard cap on agent-node iterations per turn. Reaching it ends the turn with a
# reply saying so, rather than looping forever.
MIKU_MAX_ITERATIONS=8

# --- Fan-out ----------------------------------------------------------------
# How many candidates a best-of-N delegation generates in parallel. Clamped
# down to the number of distinct angles available, so raising this on its own
# does not buy more diversity -- add angles too.
MIKU_FANOUT_BRANCHES=5

# Every model request in a turn counts against this: the main loop's calls and
# any delegated subgraph's. MIKU_MAX_ITERATIONS bounds how deep a turn goes;
# this bounds depth x breadth, which is what a fan-out actually costs.
MIKU_MAX_REQUESTS_PER_TURN=24

# --- Limits -----------------------------------------------------------------
MIKU_REQUEST_TIMEOUT=90
MIKU_MAX_RETRIES=2
MIKU_MAX_CONCURRENCY=4

# --- State ------------------------------------------------------------------
# Where state.db and traces/ live. Gitignored.
MIKU_STATE_DIR=.miku

# Who the facts in long-term memory belong to (the Store namespace).
MIKU_USER_ID=local
